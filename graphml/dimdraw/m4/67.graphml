  <key id="y" for="node" attr.name="y" attr.type="double" />
  <key id="x" for="node" attr.name="x" attr.type="double" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="x">0.0</data>
      <data key="y">14.0</data>
    </node>
    <node id="1">
      <data key="x">4.0</data>
      <data key="y">8.0</data>
    </node>
    <node id="2">
      <data key="x">-4.0</data>
      <data key="y">8.0</data>
    </node>
    <node id="3">
      <data key="x">0.0</data>
      <data key="y">10.0</data>
    </node>
    <node id="4">
      <data key="x">0.0</data>
      <data key="y">6.0</data>
    </node>
    <node id="5">
      <data key="x">3.0</data>
      <data key="y">5.0</data>
    </node>
    <node id="6">
      <data key="x">-3.0</data>
      <data key="y">5.0</data>
    </node>
    <node id="7">
      <data key="x">0.0</data>
      <data key="y">0.0</data>
    </node>
    <edge source="1" target="0" />
    <edge source="2" target="0" />
    <edge source="3" target="0" />
    <edge source="4" target="3" />
    <edge source="5" target="1" />
    <edge source="5" target="3" />
    <edge source="6" target="2" />
    <edge source="6" target="3" />
    <edge source="7" target="4" />
